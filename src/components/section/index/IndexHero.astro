---
import Button from "@/components/shared/Button.astro";
import TitleParagraph from "@/components/shared/TitleParagraph.astro";
import { Image } from "astro:assets";
import GitHubScreenshot from "~/hero/Bernardusz_GitHub.png";
---

<section
  class="section hero-background relative z-0 -mt-10 flex h-fit w-full flex-col items-center justify-center gap-16"
>
  <div class="flex h-[50vh] flex-col items-center justify-center gap-4">
    <TitleParagraph
      title="Bernardusz - Fullstack Software Engineer"
      variant="h1"
      centered
      white
      text="Hi! I'm Bernardusz, a <strong>Fullstack Software Engineer</strong> and future DevSecOps Engineer"
    />
    <div class="flex w-full flex-row justify-center gap-8">
      <Button link="/services">Hire Me</Button>
      <Button primaryOrSecondary="secondary" link="/projects">Learn More</Button
      >
    </div>
  </div>
  <Image
    src={GitHubScreenshot}
    alt="Screenshot of GitHub"
    class="-mt-24 h-auto w-full rounded-xl"
    loading="eager"
    fetchpriority="high"
    quality={80}
  />
</section>
